# ONE settings file for the whole monorepo: copy this to `.env` AT THE REPO
# ROOT (not inside apps/web, apps/bot, or packages/db). Every app and
# package reads from that single file — apps/web's API routes, apps/bot,
# apps/worker, and packages/db's `prisma`/migrate scripts all load it via
# packages/config/src/rootEnv.ts (or, for the raw `prisma` CLI, a thin
# wrapper around the same loader — see packages/db/scripts/with-root-env.ts).
# There's nothing to duplicate per-package; a per-package .env/.env.local is
# not read by any of this and will just be silently ignored.
#
# REQUIRED (packages/config/src/env.ts): DATABASE_URL, REDIS_URL,
# SESSION_SECRET, TELEGRAM_BOT_TOKEN, TELEGRAM_BOT_USERNAME,
# REDIRECT_BASE_URL. Every one of these is validated on every request to
# apps/web (loadEnv() checks the whole schema, not just the fields a given
# route uses) — leaving ANY of them blank breaks every page, not just the
# feature that var belongs to. A placeholder value is fine for local dev
# (e.g. TELEGRAM_BOT_TOKEN=dummy-dev-token) as long as it's non-empty;
# everything else in this file (chains, WalletConnect) is optional and safe
# to leave blank.

# --- Database ---
DATABASE_URL=postgresql://emp:emp@localhost:5432/emp

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Sessions / auth ---
SESSION_SECRET=change-me-32-bytes-min
# SIWE's `domain` is verified against this request's own Host header, not a
# config value — see apps/web/src/app/api/auth/siwe/verify/route.ts. Nothing
# to set here for that.
# Comma-separated wallet addresses allowed to sign in as admin.
ADMIN_WALLETS=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Account uniqueness (SPEC §7.5) ---
RELINK_COOLDOWN_DAYS=30

# --- Chains (config-driven, see packages/config/src/chains.ts) ---
# One RPC URL + treasury address + accepted-token addresses per supported
# chain. Add a new chain by adding its env vars here and one entry in
# chains.ts's CHAIN_DEFINITIONS array — no other code changes required.
#
# Treasury address is env-only, deliberately NOT admin/DB-configurable: it's
# the single highest-value config in the system (redirect it and every
# protocol payment reroutes to an attacker), so changing it requires
# server/deploy access, not just an admin session — the admin panel can only
# display it, never edit it. A chain is payable (offered to protocols,
# watched by the worker) only once it has both an RPC URL and a treasury
# address here. Leave a var blank (not set at all) for a chain you haven't
# configured yet — that's treated the same as omitting it entirely, not as
# an error.
ETHEREUM_RPC_URL=
ETHEREUM_TREASURY_ADDRESS=
ETHEREUM_USDC_ADDRESS=
ETHEREUM_USDT_ADDRESS=

ARBITRUM_RPC_URL=
ARBITRUM_TREASURY_ADDRESS=
ARBITRUM_USDC_ADDRESS=
ARBITRUM_USDT_ADDRESS=

OPTIMISM_RPC_URL=
OPTIMISM_TREASURY_ADDRESS=
OPTIMISM_USDC_ADDRESS=
OPTIMISM_USDT_ADDRESS=

BASE_RPC_URL=
BASE_TREASURY_ADDRESS=
BASE_USDC_ADDRESS=
BASE_USDT_ADDRESS=

# Robinhood chain: forthcoming, wire up once RPC/chain-id are confirmed.
ROBINHOOD_RPC_URL=
ROBINHOOD_TREASURY_ADDRESS=
ROBINHOOD_USDC_ADDRESS=
ROBINHOOD_USDT_ADDRESS=

# --- Payments ---
# Minutes a campaign's payment window stays open after moving to awaiting_payment.
PAYMENT_WINDOW_MINUTES=60

# --- Redirect / click tracking ---
# Base for every CTA's click-tracking link (SPEC §8): each becomes
# `${REDIRECT_BASE_URL}/:token`. localhost/http is fine for everything
# EXCEPT actually sending a campaign with CTAs via Telegram — Telegram's
# Bot API rejects an inline keyboard button URL that isn't a public HTTPS
# address (400 "Wrong HTTP URL"), so a real send needs this to be a real
# HTTPS host. For local testing, point it at a public tunnel back to your
# own machine (e.g. `ngrok http 3000`, then set this to the printed
# `https://<id>.ngrok-free.app/r`) — the tunnel forwards straight to your
# local /r/:token handler, so click-through and tracking both still work
# exactly as if this were deployed. See the README.
REDIRECT_BASE_URL=http://localhost:3000/r

# --- Bot -> site link-back (optional) ---
# Public URL of the web app (no trailing slash). If set, apps/bot's
# Telegram-linked confirmation message includes a tappable link back to
# /user. If blank, the message just tells the user to head back to the
# site without a link — never required for the bot to start.
WEB_BASE_URL=http://localhost:3000

# --- Client-side wallet connect (apps/web) ---
# WalletConnect Cloud project id — https://cloud.walletconnect.com. Public
# (NEXT_PUBLIC_*), not a secret; injected wallets (MetaMask etc.) still work
# without a real value, but WalletConnect's own QR/relay flow needs one.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
